# === Database (PostgreSQL) ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=samokat
POSTGRES_PASSWORD=samokat
POSTGRES_DB=samokat_rent

# === Backend ===
# Comma-separated list of allowed CORS origins (frontend URL(s))
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# JWT signing secret — change in production!
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=12h

# Default seed admin (created on first run if missing)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin

# Run DB schema sync (auto-create tables) on boot. Use false in prod with migrations.
SYNC_SCHEMA=true

# === Frontend (Vite) ===
# Base URL of the backend REST API (used by axios). In docker, nginx proxies /api.
VITE_API_URL=http://localhost:3000/api
# WebSocket URL of the backend events gateway
VITE_WS_URL=ws://localhost:3000/events
